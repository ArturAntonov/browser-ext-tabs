{
  "manifest_version": 3,
  "name": "Поиск по вкладкам",
  "version": "1.3.0",
  "description": "Быстрый поиск по открытым вкладкам: сначала текущая группа, при поиске — все группы и окна.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "action": {
    "default_title": "Поиск по вкладкам",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Открыть поиск по вкладкам"
    }
  }
}
